{
  "name": "tokendiet-mcp",
  "version": "0.1.0",
  "description": "Token-efficient MCP server for codebase architecture exploration. Save 70-90% tokens when an AI agent needs to understand a project.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "tokendiet": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/fix-sqlite-import.cjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "architecture",
    "code-exploration",
    "token-savings",
    "ai-agent",
    "claude"
  ],
  "author": "theorhd",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ignore": "^7.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}